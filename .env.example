# repo-engineer LLM planner configuration (optional).
# The deterministic benchmark (scripts/run_benchmark.py) needs NO key.
# The real-LLM benchmark (scripts/run_llm_benchmark.py) needs a provider key.
# Keys are read from the environment at call time and never committed.

# Provider: "gemini" (default, OpenAI-compatible endpoint) or "custom"
REPO_ENGINEER_LLM_PROVIDER=gemini
REPO_ENGINEER_LLM_MODEL=gemini-2.5-flash
# Required only when REPO_ENGINEER_LLM_PROVIDER=custom
# REPO_ENGINEER_LLM_BASE_URL=https://api.openai.com/v1
# Name of the env var that holds the API key itself
REPO_ENGINEER_LLM_KEY_ENV=GEMINI_API_KEY
# The key itself (do NOT commit a real value):
GEMINI_API_KEY=

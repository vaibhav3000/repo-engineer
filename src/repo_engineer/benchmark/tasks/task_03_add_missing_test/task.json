{
  "task_id": "task_03_add_missing_test",
  "description": "web/slug.py has no test coverage. Add tests/test_slug.py covering basic, punctuation and whitespace cases.",
  "verify_cmd": "python -m pytest tests/ -q",
  "protected_paths": ["web/"],
  "mutants": [
    {
      "name": "keeps upper case",
      "path": "web/slug.py",
      "find": "text.lower()",
      "replace": "text"
    },
    {
      "name": "keeps punctuation",
      "path": "web/slug.py",
      "find": "re.sub(r\"[^\\w\\s-]\", \"\", text.lower())",
      "replace": "text.lower()"
    },
    {
      "name": "keeps runs of whitespace",
      "path": "web/slug.py",
      "find": "\"-\".join(cleaned.split())",
      "replace": "cleaned.strip().replace(\" \", \"-\")"
    }
  ]
}
